# PER-ENVIRONMENT (GitOps): SANDBOX_EXECUTE_URL must resolve inside the cluster from agent-controller's namespace
# (e.g. add .default.svc.cluster.local if services are not in the same namespace).
SANDBOX_EXECUTE_URL=http://agent-sandbox/execute
COPILOT_PROVIDER=copilot
COPILOT_MODE=copilot_cli
COPILOT_PRIMARY_MODEL=gpt-5-mini
COPILOT_FALLBACK_MODEL=gpt-4o
COPILOT_CLI_COMMAND=gh copilot suggest -t shell --model {{model}}
COPILOT_PAT_REQUIRED=true
COPILOT_TIMEOUT=90
SANDBOX_TIMEOUT=90
MAX_TOOL_CONTEXT_CHARS=120000
MAX_CHAT_IMAGES=6
MAX_IMAGE_BYTES=4194304
