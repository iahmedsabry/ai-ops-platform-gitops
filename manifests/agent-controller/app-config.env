# PER-ENVIRONMENT (GitOps): Use cluster DNS Service FQDN if controller and sandbox
# namespaces differ or short names are ambiguous (update `ai-ops` to match kustomization).
SANDBOX_EXECUTE_URL=http://agent-sandbox.ai-ops.svc.cluster.local/execute
COPILOT_PROVIDER=copilot
COPILOT_MODE=copilot_cli
COPILOT_PRIMARY_MODEL=gpt-5-mini
COPILOT_FALLBACK_MODEL=gpt-4o
COPILOT_CLI_COMMAND=copilot --model {{model}}
COPILOT_PAT_REQUIRED=true
COPILOT_AUTO_CONFIRM_TRUST=true
COPILOT_TIMEOUT=90
SANDBOX_TIMEOUT=90
MAX_TOOL_CONTEXT_CHARS=120000
MAX_CHAT_IMAGES=6
MAX_IMAGE_BYTES=4194304
