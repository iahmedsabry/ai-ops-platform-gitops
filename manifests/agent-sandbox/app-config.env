# PER-ENVIRONMENT (GitOps): Regions must match the AWS account where the sandbox IRSA role runs.
# AWS_BILLING_REGION is often us-east-1 for Cost Explorer even when the cluster is elsewhere.
AWS_REGION=us-east-1
AWS_BILLING_REGION=us-east-1
# PER-ENVIRONMENT (GitOps): Prometheus Service DNS must match prometheus-app destination namespace + Service name.
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
